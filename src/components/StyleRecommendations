// StyleRecommendations.js - Style recommendations display component
import React from 'react';
import { Sparkles, X } from 'lucide-react';
import { STYLE_RECOMMENDATIONS } from '../utils/moodConfig';

const StyleRecommendations = ({ mood, onClose }) => {
  const recommendations = STYLE_RECOMMENDATIONS[mood];

  if (!recommendations) return null;

  return (
    <div className="bg-gradient-to-r from-purple-500 to-pink-500 rounded-2xl p-6 mb-6 text-white">
      <div className="flex items-center justify-between mb-4">
        <h3 className="text-xl font-bold flex items-center gap-2">
          <Sparkles className="w-6 h-6" />
          {recommendations.title}
        </h3>
        <button
          onClick={onClose}
          className="text-white/80 hover:text-white"
        >
          <X className="w-5 h-5" />
        </button>
      </div>
      <p className="text-sm text-white/90 mb-4">Based on how you're feeling today:</p>
      <ul className="space-y-2">
        {recommendations.styles.map((style, idx) => (
          <li key={idx} className="flex items-start gap-2">
            <span className="text-white/80">•</span>
            <span className="text-white/95">{style}</span>
          </li>
        ))}
      </ul>
      {recommendations.encouragement && (
        <div className="mt-4 bg-white/20 rounded-lg p-3">
          <p className="text-sm text-white italic">
            {recommendations.encouragement}
          </p>
        </div>
      )}
    </div>
  );
};

export default StyleRecommendations;


